{
  "name": "cognify",
  "displayName": "Cognify",
  "expo": {
    "name": "cognify",
    "slug": "cognify",
    "main": "index.js",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "cognify",
    "userInterfaceStyle": "automatic",
    "entryPoint": "./index.js",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMotionUsageDescription": "Cognify uses motion data to show the patient's daily step count.",
        "NSLocationWhenInUseUsageDescription": "Cognify uses location to share the patient's latest location with their caregiver.",
        "NSPhotoLibraryUsageDescription": "Cognify needs access to your photo library to upload a video for step verification."
      }
    },
    "android": {
      "permissions": ["android.permission.ACTIVITY_RECOGNITION"],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Cognify needs access to your photo library to upload a video for step verification."
        }
      ],
      [
        "expo-splash-screen",
        {
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "supabaseUrl": "https://xlusfzcawhoqzmdfgkwj.supabase.co",
      "supabaseAnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhsdXNmemNhd2hvcXptZGZna3dqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTk0MTQxNzksImV4cCI6MjA3NDk5MDE3OX0.63Mjr3oWCgGlCGANKTVt9DfByxZPSzCBIAFtfX5zyxw"
    }
  }
}
