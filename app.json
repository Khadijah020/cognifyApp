{
  "name": "cognify",
  "displayName": "Cognify",
  "expo": {
    "name": "cognify",
    "slug": "cognify",
    "main": "index.js",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "cognify",
    "userInterfaceStyle": "automatic",
    "entryPoint": "./index.js",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
